{
  "route": "image-pool",
  "label": "生图号池",
  "description": "原生号池生图插件：内置 chatgpt2api 引擎（gpt-image-2.6 / 2 + 2.6 原生 GIF），一键安装、粘贴发货文本自动登录入池；自带调用日志、图片库与消耗统计，并提供 OpenAI 兼容本地 API 接入 Agent。",
  "icon": "Image",
  "version": "1.10.1",
  "author": "Ruodao",
  "capabilities": [
    "commands",
    "code.execute",
    "image-generate",
    "gif-generation",
    "native-image-engine",
    "account-pool",
    "usage-report",
    "call-logs",
    "image-library"
  ],
  "configFields": [
    {
      "key": "RUODAO_NATIVE_PORT",
      "label": "原生号池端口（默认 38650）",
      "placeholder": "38650",
      "secret": false
    },
    {
      "key": "RUODAO_IMAGE_API_PORT",
      "label": "本地生图 API 端口（默认 8100，Agent 调用）",
      "placeholder": "8100",
      "secret": false
    },
    {
      "key": "RUODAO_IMAGE_POOL_IMAGES_DIR",
      "label": "图片保存目录（留空 = 数据目录下 images）",
      "placeholder": "D:\\RuodaoImages",
      "secret": false
    },
    {
      "key": "RUODAO_NATIVE_PYTHON",
      "label": "指定 Python 3.10+ 解释器（留空自动探测）",
      "placeholder": "C:\\Python312\\python.exe",
      "secret": false
    },
    {
      "key": "RUODAO_NATIVE_SOURCE_ZIP",
      "label": "原生引擎源码 ZIP（离线安装；留空自动下载固定版本）",
      "placeholder": "D:\\Downloads\\chatgpt2api.zip",
      "secret": false
    },
    {
      "key": "RUODAO_NATIVE_SOURCE_DIR",
      "label": "原生引擎源码目录（开发调试用；留空用固定版本）",
      "placeholder": "D:\\code\\chatgpt2api",
      "secret": false
    },
    {
      "key": "RUODAO_NATIVE_PIP_INDEX",
      "label": "原生引擎 pip 镜像（留空 = 阿里云）",
      "placeholder": "https://mirrors.aliyun.com/pypi/simple",
      "secret": false
    },
    {
      "key": "RUODAO_NATIVE_TLS_INSECURE",
      "label": "账号登录跳过 TLS 校验（1 = 跳过，仅代理环境需要）",
      "placeholder": "0",
      "secret": false
    }
  ]
}